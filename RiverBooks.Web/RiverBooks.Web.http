@RiverBooks.Web_HostAddress = http://localhost:5024

###
GET {{RiverBooks.Web_HostAddress}}/books/
Accept: application/json

###
GET {{RiverBooks.Web_HostAddress}}/books/19fce2dd-7e7a-49aa-8e73-f1780286a9e5
Accept: application/json

###
POST {{RiverBooks.Web_HostAddress}}/books
Accept: application/json
Content-Type: application/json
{
  "title" : "Modular Monoliths - Getting started",
  "author" : "Ardalis",
  "price" : 10.099,
  "description" : "So much fun !"
}

###
DELETE {{RiverBooks.Web_HostAddress}}/books/a965d81d-2632-47ea-b41d-450e485ebea0
Accept: application/json


###
PUT {{RiverBooks.Web_HostAddress}}/books/8f76bc5f-d903-44cb-8343-ead58bf75307/price
Accept: application/json
Content-Type: application/json
{
    "newPrice" : -14.099
}

###
POST {{RiverBooks.Web_HostAddress}}/users
Accept: application/json
Content-Type: application/json
{
  "email" : "shcozzi@best.com",
  "password" : "Ardalis1!"
}
#### @name login
POST {{RiverBooks.Web_HostAddress}}/users/Login
Accept: application/json
Content-Type: application/json
{
  "email" : "shcozzi@best.com",
  "password" : "Ardalis1!"
}
###
@token= {{login.response.body.$.token}}
### Add item to cart
POST {{RiverBooks.Web_HostAddress}}/cart
Authorization: Bearer {{token}}
Accept: text/plain
Content-Type: application/json

{
  "bookid" : "60043b2c-c1e6-45f4-8c6f-463569abb5ec",
  "quantity" : "2",
  "token" : "{{token}}"
}

### get cart
Get {{RiverBooks.Web_HostAddress}}/cart
Accept: application/json
Authorization: Bearer {{token}}